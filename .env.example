# Public origin for redirects and the PDF renderer when running behind a tunnel/reverse proxy (e.g. https://kveriai.example.com).
# Leave unset for relative redirects. Alternatively set TRUST_PROXY_HEADERS=1 to derive it from X-Forwarded-Host/Proto (only behind a trusted proxy).
# APP_ORIGIN=
# TRUST_PROXY_HEADERS=
# Extra hosts allowed to load Next.js dev assets through a tunnel (comma-separated)
# NEXT_ALLOWED_DEV_ORIGINS=
